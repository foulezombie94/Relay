NEXT_PUBLIC_RELAY_ENVIRONMENT=development
NEXT_PUBLIC_SUPABASE_PROJECT_REF=YOUR_DEVELOPMENT_PROJECT_REF
NEXT_PUBLIC_RELAY_PRODUCTION_PROJECT_REF=YOUR_PRODUCTION_PROJECT_REF
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_DEVELOPMENT_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_URL=http://localhost:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Temporary Ask Relay provider: use groq to enable, openai to restore.
AI_PROVIDER=openai
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
SUPABASE_SECRET_KEY=
WORKER_SECRET=
INTEGRATION_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# New integration framework stays disabled until OAuth, UI and provider acceptance tests pass.
FEATURE_INTEGRATION_PLATFORM=false
# JSON key ID -> base64 32-byte key, server-only and distinct from legacy encryption.
INTEGRATION_VAULT_KEYS=
INTEGRATION_VAULT_ACTIVE_KEY=
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Server-only secret for optional POST /api/jobs/run (enqueue only; 32+ random bytes).
JOBS_SECRET=
# Background jobs use Supabase directly; do not call a Vercel route to process them.
FEATURE_BACKGROUND_JOBS=true
# Explicit opt-in; enables only sequences already confirmed/enrolled by users.
FEATURE_SEQUENCE_SEND=false
WORKER_JOB_TYPES=email_sync,calendar_sync,workflow_run,notifications,imports
WORKER_SHORT_CONCURRENCY=2
WORKER_LONG_CONCURRENCY=1
WORKER_PORT=3001
WORKER_METRICS_SECRET=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
BETTER_STACK_SOURCE_TOKEN=
BETTER_STACK_INGEST_URL=

# Enable direct Ask Relay sends only after the documented provider acceptance tests.
FEATURE_AGENT_DIRECT_SEND=false
AGENT_OUTPUT_TOKENS=1600
# Model-specific price estimates (USD per million tokens); configure when changing models.
AGENT_INPUT_USD_PER_MILLION=0.4
AGENT_OUTPUT_USD_PER_MILLION=1.6
# Stripe billing (optional locally).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
