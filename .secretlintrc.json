{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend",
      "rules": [
        {
          "id": "@secretlint/secretlint-rule-basicauth",
          "options": {
            "allows": [
              "/^https:\\/\\/user:secret@zoom\\.us$/",
              "/^https:\\/\\/user:pass@crm\\.example\\.com$/",
              "/^https:\\/\\/user:pass@graph\\.microsoft\\.com$/",
              "/^https:\\/\\/user:pass@example\\.com$/"
            ]
          }
        },
        {
          "id": "@secretlint/secretlint-rule-database-connection-string",
          "options": {
            "allows": [
              "/^postgres:\\/\\/postgres:fixture-password@127\\.0\\.0\\.1:5432\\/relay_test_ci$/",
              "/^postgresql:\\/\\/tester:fixture@127\\.0\\.0\\.1:5432\\/relay_test_audit(?:[\";]{0,2})$/"
            ]
          }
        }
      ]
    }
  ]
}
