# Vercel / Production. All secrets stay server-only.
NEXT_PUBLIC_RELAY_ENVIRONMENT=production
NEXT_PUBLIC_SUPABASE_PROJECT_REF=YOUR_PRODUCTION_PROJECT_REF
NEXT_PUBLIC_RELAY_PRODUCTION_PROJECT_REF=YOUR_PRODUCTION_PROJECT_REF
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PRODUCTION_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
APP_URL=https://YOUR_DOMAIN
INTEGRATION_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
FEATURE_BACKGROUND_JOBS=true
FEATURE_SEQUENCE_SEND=false
JOBS_SECRET=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
BETTER_STACK_SOURCE_TOKEN=
BETTER_STACK_INGEST_URL=
# Only necessary when the Assistant is enabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_PROVIDER=openai
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Estimates only; set model-specific rates (including 0 for free test usage).
AGENT_INPUT_USD_PER_MILLION=0.4
AGENT_OUTPUT_USD_PER_MILLION=1.6
# Stripe billing (Settings › Facturation). Webhook endpoint: /api/billing/webhook
# with events checkout.session.completed and customer.subscription.*.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_AUTOMATIC_TAX=false
