# Railway / worker. Select an EU region in service settings.
NODE_ENV=production
NEXT_PUBLIC_RELAY_ENVIRONMENT=production
NEXT_PUBLIC_SUPABASE_PROJECT_REF=YOUR_PRODUCTION_PROJECT_REF
NEXT_PUBLIC_RELAY_PRODUCTION_PROJECT_REF=YOUR_PRODUCTION_PROJECT_REF
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PRODUCTION_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=
APP_URL=https://YOUR_DOMAIN
INTEGRATION_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FEATURE_INTEGRATION_PLATFORM=false
INTEGRATION_VAULT_KEYS=
INTEGRATION_VAULT_ACTIVE_KEY=
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Same provider selection as the web. Set the matching key on Railway too.
AI_PROVIDER=openai
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
FEATURE_BACKGROUND_JOBS=true
FEATURE_SEQUENCE_SEND=false
WORKER_JOB_TYPES=email_sync,calendar_sync,workflow_run,notifications,imports
# Per replica: 1..4 slots in each lane. Total default concurrency is 3.
WORKER_SHORT_CONCURRENCY=2
WORKER_LONG_CONCURRENCY=1
WORKER_METRICS_SECRET=
SENTRY_DSN=
BETTER_STACK_SOURCE_TOKEN=
BETTER_STACK_INGEST_URL=
# Railway provides PORT automatically. Local default: 3001.
# Periodic maintenance (trash retention, webhooks, enrichment, seat sync). Set false to disable all.
FEATURE_WORKER_MAINTENANCE=true
# Company enrichment from public websites; the French public registry can be turned off separately.
FEATURE_ENRICHMENT=true
ENRICHMENT_FR_REGISTRY=true
# Webhook delivery requires INTEGRATION_ENCRYPTION_KEY (signing secrets are sealed with it).
# Seat reconciliation runs only when the Stripe key is set (same value as the web).
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
