FROM public.ecr.aws/docker/library/node:24-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20
ENV NODE_ENV=production
WORKDIR /app
COPY --chmod=0644 package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --chmod=0644 tsconfig.json ./
COPY --chmod=0644 scripts/worker.mts scripts/worker.mts
COPY src/lib ./src/lib
RUN chmod 0755 ./scripts && chmod -R a=rX ./src/lib
USER node
CMD ["npm", "run", "worker"]
